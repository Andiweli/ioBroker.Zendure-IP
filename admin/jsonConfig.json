{
  "i18n": true,
  "type": "panel",
  "items": {
    "devicesHeader": {
      "type": "header",
      "text": "Configure up to 10 Zendure devices.",
      "newLine": true,
      "style": {
        "fontSize": "1.1em"
      }
    },
    "devicesText": {
      "type": "staticText",
      "text": "The adapter polls each device. Set the battery capacity in kWh for correct HEMS energyRemainingKWh and energyUsableKWh values. Enable 'Device is in HEMS' for devices that should be included in the aggregated HEMS object tree.",
      "style": {
        "fontSize": "1.05em",
        "marginBottom": "0.75rem"
      }
    },
    "devices": {
      "newLine": true,
      "type": "table",
      "sm": 12,
      "xs": 12,
      "maxLength": 10,
      "items": [
        {
          "type": "text",
          "attr": "name",
          "title": "Device name",
          "width": "22%"
        },
        {
          "type": "text",
          "attr": "ip",
          "title": "IP address",
          "width": "22%"
        },
        {
          "type": "number",
          "attr": "capacityKWh",
          "title": "Capacity (kWh)",
          "min": 0.1,
          "step": 0.1,
          "default": 2.4,
          "width": "18%"
        },
        {
          "type": "number",
          "attr": "intervalSec",
          "title": "Interval (s)",
          "min": 1,
          "step": 1,
          "default": 10,
          "width": "15%"
        },
        {
          "type": "checkbox",
          "attr": "isInHems",
          "title": "Device is in HEMS",
          "width": "18%"
        }
      ],
      "style": {
        "fontSize": "1.03em"
      }
    },
    "capacityHeader": {
      "type": "header",
      "text": "Capacity examples",
      "newLine": true,
      "style": {
        "fontSize": "1.1em",
        "marginTop": "1rem"
      }
    },
    "capacityText": {
      "type": "staticText",
      "text": "Typical values: 1600AC+ = 2.0 kWh, 2400AC+ = 2.4 kWh, 2400 Pro with your current 3-battery setup = 7.4 kWh. Adjust these values if your battery setup changes.",
      "style": {
        "fontSize": "1.05em",
        "marginBottom": "0.75rem"
      }
    },
    "noteHeader": {
      "type": "header",
      "text": "Note",
      "newLine": true,
      "style": {
        "fontSize": "1.1em",
        "marginTop": "1rem"
      }
    },
    "noteText": {
      "type": "staticText",
      "text": "This adapter is read-only. It does not control Zendure devices; it only reads device data and generates daily counters.",
      "style": {
        "fontSize": "1.05em"
      }
    },
    "noteLink": {
      "type": "staticLink",
      "text": "For full control features, Zendure SolarFlow adapter is recommended.",
      "href": "https://github.com/nograx/ioBroker.zendure-solarflow",
      "button": false,
      "icon": "link",
      "style": {
        "fontSize": "1.05em"
      }
    }
  }
}
